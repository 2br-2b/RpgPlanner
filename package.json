{
  "name": "campaign-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-licenses.js",
    "dev": "concurrently -n vite,server -c cyan,yellow \"vite\" \"tsx watch server/index.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "gen-licenses": "node scripts/gen-licenses.js",
    "prebuild": "node scripts/gen-licenses.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "start": "node build/server/index.js",
    "preview": "vite preview",
    "test:migration": "node scripts/test-migration.js"
  },
  "dependencies": {
    "@milkdown/core": "^7.21.2",
    "@milkdown/plugin-clipboard": "^7.21.2",
    "@milkdown/plugin-emoji": "^7.21.2",
    "@milkdown/plugin-history": "^7.21.2",
    "@milkdown/plugin-listener": "^7.21.2",
    "@milkdown/plugin-trailing": "^7.21.2",
    "@milkdown/plugin-upload": "^7.21.2",
    "@milkdown/preset-commonmark": "^7.21.2",
    "@milkdown/prose": "^7.21.2",
    "@milkdown/react": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "@types/dompurify": "^3.2.0",
    "@xyflow/react": "^12.11.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "emoji-picker-react": "^4.19.1",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.5",
    "react": "^19.2.6",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "25.9.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
